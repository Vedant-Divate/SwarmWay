      "type": "integer"
    },
    "solver": {
      "$ref": "#/$defs/SolverBlock"
    },
    "instance": {
      "$ref": "#/$defs/InstanceBlock"
    },
    "result": {
      "$ref": "#/$defs/ResultBlock"
    },
    "search": {
      "items": {
        "$ref": "#/$defs/SearchEvent"
      },
      "title": "Search",
      "type": "array"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionBlock"
    }
  },
  "required": [
    "solver",
    "instance",
    "result",
    "execution"
  ],
  "title": "TraceV1",
  "type": "object"
