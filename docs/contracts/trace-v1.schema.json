          "title": "Node",
          "type": "integer"
        },
        "cost": {
          "title": "Cost",
          "type": "integer"
        },
        "parent": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "conflict": {
          "anyOf": [
            {
              "$ref": "#/$defs/Conflict"
            },
            {
              "type": "null"
            }
