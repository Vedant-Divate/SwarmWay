# Swarmway environment variables (Section 17.1)
# Copy to .env and adjust as needed. No secrets are required by design.

# API
SWARMWAY_API_HOST=127.0.0.1
SWARMWAY_API_PORT=8000
SWARMWAY_CORS_ORIGINS=http://localhost:5173,https://<user>.github.io

# Resource caps (server-enforced)
SWARMWAY_MAX_AGENTS=60
SWARMWAY_MAX_GRID_CELLS=262144
SWARMWAY_SOLVE_BUDGET_MS=10000
SWARMWAY_TRACE_EVENT_CAP=20000

# Frontend (build-time)
VITE_API_BASE_URL=http://localhost:8000
